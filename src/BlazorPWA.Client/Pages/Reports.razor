@page "/reports"
@using BlazorPWA.Client.Services
@using BlazorPWA.Shared.Models

<PageTitle>Inspection Reports</PageTitle>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-data"></i> Inspection Reports</h2>
        <a href="/reports/new" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Inspection
        </a>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!_reports.Any())
    {
        <div class="alert alert-info">
            No reports found. Create your first inspection report.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Facility</th>
                        <th>Inspector</th>
                        <th>Status</th>
                        <th>Sync</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in _reports)
                    {
                        <tr>
                            <td>@report.Title</td>
                            <td>@report.FacilityName</td>
                            <td>@report.InspectorName</td>
                            <td><span class="badge bg-secondary">@report.Status</span></td>
                            <td><span class="badge bg-warning text-dark">@report.SyncStatus</span></td>
                            <td>@report.UpdatedAt.ToString("g")</td>
                            <td>
                                <a href="/reports/@report.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Inject] private IndexedDbService IndexedDb { get; set; } = default!;

    private List<InspectionReport> _reports = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _reports = await IndexedDb.GetAllEntitiesAsync<InspectionReport>("InspectionReport");
        _reports = _reports.OrderByDescending(r => r.UpdatedAt).ToList();
        _loading = false;
    }
}

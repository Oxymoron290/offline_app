@page "/"
@using BlazorHybrid.App.Data.Repositories
@using BlazorHybrid.App.Services.Auth
@using BlazorHybrid.App.Services.Connectivity
@using BlazorHybrid.App.Services.Sync
@inject IAuthService AuthService
@inject IConnectivityService Connectivity
@inject ISyncService SyncService
@inject IEntityRepository EntityRepo

<h1>Case Worker Dashboard</h1>

<div class="container">
    <div class="row mb-3">
        <div class="col">
            @if (AuthService.IsAuthenticated)
            {
                <div class="alert alert-success">
                    <strong>Signed in as:</strong> @AuthService.UserName
                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LogoutAsync">Sign Out</button>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <strong>Not signed in.</strong>
                    <button class="btn btn-sm btn-primary ms-2" @onclick="LoginAsync">Sign In</button>
                </div>
            }
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Connectivity</h5>
                    <span class="badge @(Connectivity.IsConnected ? "bg-success" : "bg-danger") fs-6">
                        @(Connectivity.IsConnected ? "Online" : "Offline")
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Entities</h5>
                    <p class="display-6">@entityCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Pending Sync</h5>
                    <p class="display-6">@pendingSyncCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <a href="entities" class="btn btn-primary btn-lg w-100 mb-2">Manage Entities</a>
        </div>
        <div class="col-md-6">
            <a href="sync" class="btn btn-outline-primary btn-lg w-100 mb-2">View Sync Status</a>
        </div>
    </div>
</div>

@code {
    private int entityCount;
    private int pendingSyncCount;

    protected override async Task OnInitializedAsync()
    {
        var entities = await EntityRepo.GetAllAsync();
        entityCount = entities.Count;
        pendingSyncCount = await SyncService.GetPendingCountAsync();
    }

    private async Task LoginAsync()
    {
        await AuthService.LoginAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        StateHasChanged();
    }
}
